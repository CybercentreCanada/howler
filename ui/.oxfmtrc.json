{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "avoid",
  "printWidth": 120,
  "singleQuote": true,
  "trailingComma": "none",
  "sortPackageJson": false,
  "ignorePatterns": [
    "src/models/entities/generated",
    "src/locales/en/**/*.json",
    "src/locales/fr/**/*.json",
    "src/plugins/clue/locales/*.json"
  ]
}
